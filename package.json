{
  "name": "optiqra",
  "version": "2.4.15",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "tauri": "tauri",
    "desktop:dev": "concurrently -k \"next dev -p 4173\" \"tauri dev\"",
    "desktop:build": "DOCKER_BUILD=1 next build && npm run desktop:compile && npm run desktop:package && tauri build",
    "desktop:compile": "tsc -p server/tsconfig.json",
    "desktop:package": "node server/scripts/package-sidecar.js"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.67.0",
    "cheerio": "^1.2.0",
    "docx": "^9.7.1",
    "idb": "^8.0.0",
    "image-size": "^2.0.2",
    "jsdom": "^25.0.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "next": "16.3.0",
    "next-pwa": "^5.6.0",
    "node-notifier": "^10.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.180.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "@yao-pkg/pkg": "^6",
    "concurrently": "^9",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
