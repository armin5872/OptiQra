{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OptiQra",
  "version": "2.5.1",
  "identifier": "com.optiqra.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:4173",
    "frontendDist": "../.next-tauri-placeholder"
  },
  "app": {
    "windows": [
      {
        "title": "OptiQra",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "url": "http://localhost:4173",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/optiqra-server"],
    "resources": {
      "binaries/.next/standalone": "next-standalone"
    },
    "createUpdaterArtifacts": true,
    "publisher": "OptiQra",
    "homepage": "https://optiqra.app",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "startMenuFolder": "OptiQra",
        "installerHooks": "installer/nsis-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/armin5872/OptiQra/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGMEE5RDQ0RjFFNTc5MzEKUldReGVlWHhSSjBLdi9FaWVMZG5wZFN3MWplM3BTTE94cmIzQ0JEb3JDWTJHRTRSVDhjK2tCL0cK"
    }
  }
}
